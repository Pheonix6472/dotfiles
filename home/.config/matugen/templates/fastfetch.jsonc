{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii-art.txt",
    "color": {
      "1": "{{colors.primary.default.hex}}",
    },
  },
  "color": {
    "1": "{{colors.primary.default.hex}}",
    "2": "{{colors.secondary.default.hex}}",
    "3": "{{colors.tertiary.default.hex}}",
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.primary.default.hex}}",
      "output": "{{colors.on_surface.default.hex}}",
      "separator": "{{colors.outline.default.hex}}",
    },
    "key": {
      "width": 16,
    },
    "bar": {
      "width": 12,
      "char": {
        "elapsed": "━",
        "total": "─",
      },
    },
    "percent": {
      "type": 3,
      "green": 35,
      "yellow": 70,
    },
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
    },
    {
      "type": "custom",
      "format": "╭─ SYSTEM OVERVIEW ───────────────────",
    },
    {
      "type": "os",
      "key": "󰣇  OS",
      "format": "{name} {version}",
    },
    {
      "type": "command",
      "key": "󰌢  HOST",
      "text": "cat /sys/class/dmi/id/board_name",
    },
    {
      "type": "kernel",
      "key": "󰒋  KERNEL",
    },
    {
      "type": "uptime",
      "key": "󰅐  UPTIME",
    },
    {
      "type": "packages",
      "key": "󰏖  PACKAGES",
    },
    {
      "type": "shell",
      "key": "󰘧  SHELL",
    },
    {
      "type": "terminal",
      "key": "󰆍  TERMINAL",
    },

    "break",
    {
      "type": "custom",
      "format": "╭─ MANGO / WAYLAND ───────────────────",
    },
    {
      "type": "de",
      "key": "󰧨  DESKTOP",
    },
    {
      "type": "wm",
      "key": "󰖲  COMPOSITOR",
    },
    {
      "type": "display",
      "key": "󰍹  DISPLAYS",
    },
    {
      "type": "command",
      "key": "󰆍  SESSION",
      "text": "printf '%s / %s' \"${XDG_SESSION_TYPE:-unknown}\" \"${XDG_CURRENT_DESKTOP:-unknown}\"",
    },

    "break",
    {
      "type": "custom",
      "format": "╭─ HARDWARE / COMPUTE ────────────────",
    },
    {
      "type": "cpu",
      "key": "󰻠  CPU",
      "format": "{name} ({cores-physical}C/{cores-logical}T)",
    },
    {
      "type": "cpuusage",
      "key": "󰓅  CPU LOAD",
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU",
      "format": "{name}",
    },
    {
      "type": "command",
      "key": "󰍛  GPU LOAD",
      "text": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    },
    {
      "type": "command",
      "key": "󰾆  VRAM",
      "text": "nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader",
    },
    {
      "type": "command",
      "key": "󰔏  GPU TEMP",
      "text": "nvidia-smi --query-gpu=temperature.gpu,power.draw --format=csv,noheader",
    },

    "break",
    {
      "type": "custom",
      "format": "╭─ MEMORY / STORAGE ──────────────────",
    },
    {
      "type": "memory",
      "key": "󰍛  RAM",
    },
    {
      "type": "swap",
      "key": "󰓡  SWAP",
    },
    {
      "type": "disk",
      "key": "󰋊  ROOT",
      "folders": ["/"],
    },
    {
      "type": "disk",
      "key": "󰋊  HOME",
      "folders": ["/home"],
    },
    {
      "type": "disk",
      "key": "󰋊  BTRFS",
      "folders": ["/home/$USER/hdd"],
    },

    "break",
    {
      "type": "custom",
      "format": "╰─ COLOR PALETTE ─────────────────────",
    },
    {
      "type": "colors",
      "symbol": "block",
    },
  ],
}
