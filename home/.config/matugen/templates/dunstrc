[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (18, 18)
    width = (320, 420)
    height = (0, 300)
    gap_size = 10
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 14
    frame_width = 0
    separator_height = 0
    corner_radius = 20
    icon_corner_radius = 12
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 5
    font = JetBrainsMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = end
    icon_position = left
    min_icon_size = 40
    max_icon_size = 56
    icon_theme = Papirus
    enable_recursive_icon_lookup = true
    sticky_history = yes
    history_length = 20
    browser = xdg-open
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "{{colors.surface_container.default.hex}}f2"
    foreground = "{{colors.on_surface_variant.default.hex}}"
    highlight = "{{colors.primary.default.hex}}"
    timeout = 5

[urgency_normal]
    background = "{{colors.surface.default.hex}}f2"
    foreground = "{{colors.on_surface.default.hex}}"
    highlight = "{{colors.primary.default.hex}}"
    timeout = 8

[urgency_critical]
    background = "{{colors.error_container.default.hex}}f2"
    foreground = "{{colors.on_error_container.default.hex}}"
    highlight = "{{colors.error.default.hex}}"
    timeout = 0
