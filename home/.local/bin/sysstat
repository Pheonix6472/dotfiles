#!/usr/bin/env python3
# sysstat: low-overhead resource logger (daemon mode) and report tool (CLI mode)
import argparse, glob, json, math, os, re, shutil, signal, sqlite3, subprocess, sys, threading, time
from collections import defaultdict

DB_DIR = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "sysstat")
DB_PATH = os.path.join(DB_DIR, "stats.db")
TICK = 5          # seconds between samples
PROC_EVERY = 2    # scan processes every N ticks
FLUSH_EVERY = 30  # seconds between database writes
SCALE = 25        # log-histogram resolution (about 4 percent steps)
CLK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
DISK_RE = re.compile(r"(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|mmcblk[0-9]+)")

METRICS = {
    "cpu_percent": ("CPU usage", "%", "CPU"),
    "cpu_freq_mhz": ("CPU frequency (core avg)", "MHz", "CPU"),
    "cpu_temp_c": ("CPU temperature", "C", "CPU"),
    "load1": ("Load average (1 min)", "", "CPU"),
    "procs_total": ("Threads (total)", "#", "CPU"),
    "ram_percent": ("RAM used", "%", "Memory"),
    "ram_used_mb": ("RAM used", "MB", "Memory"),
    "swap_used_mb": ("Swap used", "MB", "Memory"),
    "gpu_util_percent": ("GPU usage", "%", "GPU"),
    "gpu_mem_used_mb": ("GPU memory used", "MB", "GPU"),
    "gpu_temp_c": ("GPU temperature", "C", "GPU"),
    "gpu_power_w": ("GPU power draw", "W", "GPU"),
    "gpu_clock_mhz": ("GPU core clock", "MHz", "GPU"),
    "igpu_util_percent": ("iGPU usage (Radeon 610M)", "%", "GPU"),
    "igpu_mem_used_mb": ("iGPU memory used", "MB", "GPU"),
    "igpu_temp_c": ("iGPU temperature", "C", "GPU"),
    "disk_read_mbs": ("Disk read", "MB/s", "Disk and network"),
    "disk_write_mbs": ("Disk write", "MB/s", "Disk and network"),
    "net_rx_kbs": ("Network download", "KB/s", "Disk and network"),
    "net_tx_kbs": ("Network upload", "KB/s", "Disk and network"),
    "psi_cpu": ("CPU stall time (PSI)", "%", "Pressure (share of time tasks were stalled)"),
    "psi_mem": ("Memory stall time (PSI)", "%", "Pressure (share of time tasks were stalled)"),
    "psi_io": ("IO stall time (PSI)", "%", "Pressure (share of time tasks were stalled)"),
    "battery_percent": ("Battery charge", "%", "Battery"),
    "battery_power_w": ("Battery power", "W", "Battery"),
}
GROUPS = list(dict.fromkeys(m[2] for m in METRICS.values()))
COLS = ["min", "p25", "median", "avg", "p75", "p95", "p99", "max", "last"]

SCHEMA = [
    "CREATE TABLE IF NOT EXISTS stats(name TEXT PRIMARY KEY, n INTEGER, total REAL, vmin REAL, vmax REAL, last REAL, first_ts REAL, last_ts REAL)",
    "CREATE TABLE IF NOT EXISTS hist(name TEXT, bin INTEGER, n INTEGER, PRIMARY KEY(name, bin))",
    "CREATE TABLE IF NOT EXISTS hourly(hour INTEGER, name TEXT, n INTEGER, total REAL, vmax REAL, PRIMARY KEY(hour, name))",
    "CREATE TABLE IF NOT EXISTS procs(name TEXT PRIMARY KEY, cpu_s REAL, rss_sum REAL, rss_max REAL, samples INTEGER)",
    "CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value REAL)",
    "CREATE TABLE IF NOT EXISTS boots(boot_id TEXT PRIMARY KEY, first_seen REAL, last_seen REAL, tracked REAL)",
]

def read(path):
    with open(path, errors="replace") as f:
        return f.read()

def find_hwmon(names):
    base = "/sys/class/hwmon"
    try:
        for d in sorted(os.listdir(base)):
            try:
                if read(base + "/" + d + "/name").strip() in names:
                    return base + "/" + d
            except OSError:
                pass
    except OSError:
        pass
    return None

class Gpu:
    def __init__(self):
        self.vals = {}
        self.proc = None
        self.amd = None
        for d in sorted(glob.glob("/sys/class/drm/card[0-9]/device")):
            try:
                if read(d + "/vendor").strip() == "0x1002" and os.path.exists(d + "/gpu_busy_percent"):
                    self.amd = d
                    break
            except OSError:
                pass
        if shutil.which("nvidia-smi") and os.environ.get("SYSSTAT_NVIDIA", "1") != "0":
            threading.Thread(target=self._run_nvidia, daemon=True).start()

    def _run_nvidia(self):
        cmd = ["nvidia-smi", "-i", "0", "--query-gpu=utilization.gpu,memory.used,temperature.gpu,power.draw,clocks.gr",
               "--format=csv,noheader,nounits", "-l", "5"]
        try:
            self.proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return
        for line in self.proc.stdout:
            parts = [x.strip() for x in line.split(",")]
            v = {}
            for key, i in (("gpu_util_percent", 0), ("gpu_mem_used_mb", 1), ("gpu_temp_c", 2), ("gpu_power_w", 3), ("gpu_clock_mhz", 4)):
                try:
                    v[key] = float(parts[i])
                except (IndexError, ValueError):
                    pass
            self.vals = v
        self.vals = {}

    def sample(self):
        o = dict(self.vals)
        if not self.amd:
            return o
        d = self.amd
        for key, f, div in (("igpu_util_percent", "gpu_busy_percent", 1), ("igpu_mem_used_mb", "mem_info_vram_used", 1048576)):
            try:
                o[key] = float(read(d + "/" + f)) / div
            except (OSError, ValueError):
                pass
        for h in glob.glob(d + "/hwmon/hwmon*"):
            try:
                o["igpu_temp_c"] = float(read(h + "/temp1_input")) / 1000
            except (OSError, ValueError):
                pass
        return o

    def close(self):
        if self.proc:
            self.proc.terminate()

class Sampler:
    def __init__(self):
        self.prev_cpu = self.prev_disk = self.prev_net = None
        self.freq_files = glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq")
        hw = find_hwmon(("k10temp", "coretemp", "zenpower", "cpu_thermal"))
        self.temp_file = hw + "/temp1_input" if hw else None
        bats = sorted(glob.glob("/sys/class/power_supply/BAT*"))
        self.bat = bats[0] if bats else None
        self.gpu = Gpu()

    def sample(self, dt):
        o = {}
        ok = 0 < dt <= 3 * TICK
        fl = [int(x) for x in read("/proc/stat").splitlines()[0].split()[1:9]]
        idle, total = fl[3] + fl[4], sum(fl)
        if self.prev_cpu and total > self.prev_cpu[1]:
            o["cpu_percent"] = 100.0 * (1 - (idle - self.prev_cpu[0]) / (total - self.prev_cpu[1]))
        self.prev_cpu = (idle, total)
        fr = []
        for p in self.freq_files:
            try:
                fr.append(int(read(p)))
            except (OSError, ValueError):
                pass
        if fr:
            o["cpu_freq_mhz"] = sum(fr) / len(fr) / 1000
        if self.temp_file:
            try:
                o["cpu_temp_c"] = int(read(self.temp_file)) / 1000
            except (OSError, ValueError):
                pass
        la = read("/proc/loadavg").split()
        o["load1"] = float(la[0])
        o["procs_total"] = float(la[3].split("/")[1])
        mi = {}
        for line in read("/proc/meminfo").splitlines():
            k, _, v = line.partition(":")
            if k in ("MemTotal", "MemAvailable", "SwapTotal", "SwapFree"):
                mi[k] = int(v.split()[0])
        if len(mi) == 4:
            used = mi["MemTotal"] - mi["MemAvailable"]
            o["ram_used_mb"] = used / 1024
            o["ram_percent"] = 100.0 * used / mi["MemTotal"]
            o["swap_used_mb"] = (mi["SwapTotal"] - mi["SwapFree"]) / 1024
        for res, key in (("cpu", "psi_cpu"), ("memory", "psi_mem"), ("io", "psi_io")):
            try:
                o[key] = float(read("/proc/pressure/" + res).splitlines()[0].split("avg10=")[1].split()[0])
            except (OSError, IndexError, ValueError):
                pass
        rd = wr = 0
        for line in read("/proc/diskstats").splitlines():
            f = line.split()
            if len(f) > 9 and DISK_RE.fullmatch(f[2]):
                rd += int(f[5])
                wr += int(f[9])
        if self.prev_disk and ok:
            o["disk_read_mbs"] = max(0, rd - self.prev_disk[0]) * 512 / 1048576 / dt
            o["disk_write_mbs"] = max(0, wr - self.prev_disk[1]) * 512 / 1048576 / dt
        self.prev_disk = (rd, wr)
        rx = tx = 0
        for line in read("/proc/net/dev").splitlines()[2:]:
            name, _, rest = line.partition(":")
            if name.strip() == "lo":
                continue
            f = rest.split()
            rx += int(f[0])
            tx += int(f[8])
        if self.prev_net and ok:
            o["net_rx_kbs"] = max(0, rx - self.prev_net[0]) / 1024 / dt
            o["net_tx_kbs"] = max(0, tx - self.prev_net[1]) / 1024 / dt
        self.prev_net = (rx, tx)
        if self.bat:
            for key, f, div in (("battery_percent", "capacity", 1), ("battery_power_w", "power_now", 1e6)):
                try:
                    o[key] = float(read(self.bat + "/" + f)) / div
                except (OSError, ValueError):
                    pass
        o.update(self.gpu.sample())
        return o

class Pending:
    def __init__(self):
        self.reset()

    def reset(self):
        self.stats, self.hourly, self.procs = {}, {}, {}
        self.hist = defaultdict(int)
        self.tracked = 0.0

    def add(self, name, v, hour, ts):
        s = self.stats.get(name)
        if s is None:
            self.stats[name] = [1, v, v, v, v, ts, ts]
        else:
            s[0] += 1
            s[1] += v
            s[2] = min(s[2], v)
            s[3] = max(s[3], v)
            s[4] = v
            s[6] = ts
        self.hist[(name, int(round(math.log1p(max(v, 0.0)) * SCALE)))] += 1
        h = self.hourly.setdefault((hour, name), [0, 0.0, v])
        h[0] += 1
        h[1] += v
        h[2] = max(h[2], v)

def scan_procs(prev, pend):
    cur, agg = {}, {}
    first = not prev
    for e in os.listdir("/proc"):
        if not e.isdigit():
            continue
        try:
            data = read("/proc/" + e + "/stat")
            r = data.rfind(")")
            f = data[r + 2:].split()
            name = data[data.find("(") + 1:r]
            rss = int(f[21]) * PAGE
            key = e + ":" + f[19]
            jiff = int(f[11]) + int(f[12])
        except (OSError, IndexError, ValueError):
            continue
        cur[key] = jiff
        delta = 0 if first else max(0, jiff - prev.get(key, 0))
        if rss == 0:
            name = "[kernel] " + re.sub(r"[0-9]+", "N", name)
        a = agg.setdefault(name, [0, 0])
        a[0] += delta
        a[1] += rss
    for name, (dj, rss) in agg.items():
        p = pend.procs.setdefault(name, [0.0, 0.0, 0.0, 0])
        p[0] += dj / CLK
        p[1] += rss
        p[2] = max(p[2], rss)
        p[3] += 1
    return cur

def flush(db, p, boot_id):
    if not p.stats:
        return
    now = time.time()
    with db:
        for name, s in p.stats.items():
            db.execute("INSERT INTO stats VALUES(?,?,?,?,?,?,?,?) ON CONFLICT(name) DO UPDATE SET "
                       "n=n+excluded.n, total=total+excluded.total, vmin=MIN(vmin,excluded.vmin), "
                       "vmax=MAX(vmax,excluded.vmax), last=excluded.last, last_ts=excluded.last_ts", (name, *s))
        db.executemany("INSERT INTO hist VALUES(?,?,?) ON CONFLICT(name,bin) DO UPDATE SET n=n+excluded.n",
                       [(k[0], k[1], n) for k, n in p.hist.items()])
        db.executemany("INSERT INTO hourly VALUES(?,?,?,?,?) ON CONFLICT(hour,name) DO UPDATE SET "
                       "n=n+excluded.n, total=total+excluded.total, vmax=MAX(vmax,excluded.vmax)",
                       [(k[0], k[1], *v) for k, v in p.hourly.items()])
        db.executemany("INSERT INTO procs VALUES(?,?,?,?,?) ON CONFLICT(name) DO UPDATE SET "
                       "cpu_s=cpu_s+excluded.cpu_s, rss_sum=rss_sum+excluded.rss_sum, "
                       "rss_max=MAX(rss_max,excluded.rss_max), samples=samples+excluded.samples",
                       [(k, *v) for k, v in p.procs.items()])
        db.execute("UPDATE meta SET value=value+? WHERE key=?", (p.tracked, "tracked_total"))
        db.execute("UPDATE boots SET last_seen=?, tracked=tracked+? WHERE boot_id=?", (now, p.tracked, boot_id))
        db.execute("DELETE FROM hourly WHERE hour < ?", (int(now // 3600) - 24 * 90,))
    p.reset()

def daemon():
    os.makedirs(DB_DIR, exist_ok=True)
    db = sqlite3.connect(DB_PATH)
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA synchronous=NORMAL")
    for stmt in SCHEMA:
        db.execute(stmt)
    boot_id = read("/proc/sys/kernel/random/boot_id").strip()
    now = time.time()
    with db:
        db.execute("INSERT OR IGNORE INTO meta VALUES(?,?)", ("first_start", now))
        db.execute("INSERT OR IGNORE INTO meta VALUES(?,0)", ("tracked_total",))
        db.execute("INSERT OR IGNORE INTO meta VALUES(?,0)", ("daemon_starts",))
        db.execute("UPDATE meta SET value=value+1 WHERE key=?", ("daemon_starts",))
        db.execute("INSERT OR IGNORE INTO boots VALUES(?,?,?,0)", (boot_id, now, now))
    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *a: stop.set())
    signal.signal(signal.SIGINT, lambda *a: stop.set())
    smp, pend, prev_procs = Sampler(), Pending(), {}
    tick, last_mono = 0, None
    last_flush = nxt = time.monotonic()
    while not stop.is_set():
        mono = time.monotonic()
        dt = (mono - last_mono) if last_mono else 0.0
        last_mono = mono
        ts = time.time()
        hour = int(ts // 3600)
        try:
            for k, v in smp.sample(dt).items():
                pend.add(k, v, hour, ts)
            pend.tracked += min(dt, 2 * TICK)
            if tick % PROC_EVERY == 0:
                prev_procs = scan_procs(prev_procs, pend)
        except Exception as e:
            print("sample error: %s" % e, file=sys.stderr)
        tick += 1
        if mono - last_flush >= FLUSH_EVERY:
            flush(db, pend, boot_id)
            last_flush = mono
        nxt += TICK
        wait = nxt - time.monotonic()
        if wait < 0:  # clock jumped (suspend), resync
            nxt, wait = time.monotonic(), 0
        stop.wait(wait)
    flush(db, pend, boot_id)
    smp.gpu.close()

def hv(unit, v):
    if v is None:
        return "-"
    if unit == "%":
        return "%.1f%%" % v
    if unit == "C":
        return "%.1f C" % v
    if unit == "W":
        return "%.1f W" % v
    if unit == "MHz":
        return "%.2f GHz" % (v / 1000) if v >= 1000 else "%.0f MHz" % v
    if unit in ("MB", "MB/s"):
        return "%.2f G%s" % (v / 1024, unit[1:]) if v >= 1024 else "%.1f %s" % (v, unit)
    if unit == "KB/s":
        return "%.2f MB/s" % (v / 1024) if v >= 1024 else "%.1f KB/s" % v
    if unit == "#":
        return "%.0f" % v
    return "%.2f" % v

def fmt(unit, v, human):
    if not human:
        return "-" if v is None else "%.3f" % v
    return hv(unit, v)

def dur(s):
    s = int(s)
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    if d:
        return "%dd %dh %dm" % (d, h, m)
    if h:
        return "%dh %dm" % (h, m)
    if m:
        return "%dm %ds" % (m, s)
    return "%ds" % s

def ts_fmt(t):
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(t))

def title(t, human):
    print(("\n== %s ==" % t) if human else ("# " + t))

def table(rows, human, left=False):
    if not human:
        for r in rows:
            print("\t".join(r))
        return
    w = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(w[i]) if (i == 0 or left) else c.rjust(w[i]) for i, c in enumerate(r)))

def pct(bins, n, q, vmin, vmax):
    target, cum = q * n, 0
    for b, c in bins:
        cum += c
        if cum >= target:
            return min(max(math.expm1(b / SCALE), vmin), vmax)
    return vmax

def collect(db):
    meta = dict(db.execute("SELECT key, value FROM meta"))
    boots = [dict(zip(("boot_id", "first_seen", "last_seen", "tracked"), r))
             for r in db.execute("SELECT boot_id, first_seen, last_seen, tracked FROM boots ORDER BY first_seen")]
    hb = defaultdict(list)
    for name, b, n in db.execute("SELECT name, bin, n FROM hist ORDER BY name, bin"):
        hb[name].append((b, n))
    stats = {}
    for name, n, total, vmin, vmax, last, lts in db.execute("SELECT name, n, total, vmin, vmax, last, last_ts FROM stats"):
        q = lambda p: pct(hb[name], n, p, vmin, vmax)
        stats[name] = {"samples": n, "min": vmin, "p25": q(0.25), "median": q(0.5), "avg": total / n,
                       "p75": q(0.75), "p95": q(0.95), "p99": q(0.99), "max": vmax, "last": last, "last_ts": lts}
    procs = [{"name": r[0], "cpu_s": r[1], "avg_rss": r[2] / r[4], "max_rss": r[3], "samples": r[4]}
             for r in db.execute("SELECT name, cpu_s, rss_sum, rss_max, samples FROM procs") if r[4] > 0]
    return {"meta": meta, "boots": boots, "stats": stats, "procs": procs}

def cpu_model():
    try:
        for line in read("/proc/cpuinfo").splitlines():
            if line.startswith("model name"):
                return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return "?"

def history(db, hours, human):
    cutoff = int(time.time() // 3600) - hours + 1
    data = defaultdict(dict)
    for h, name, n, total, vmax in db.execute("SELECT hour, name, n, total, vmax FROM hourly WHERE hour >= ? ORDER BY hour", (cutoff,)):
        data[h][name] = (total / n, vmax)
    cols = []
    for name, short in (("cpu_percent", "cpu"), ("ram_percent", "ram"), ("gpu_util_percent", "gpu")):
        cols += [(name, 0, short + "_avg"), (name, 1, short + "_max")]
    cols += [("cpu_temp_c", 1, "cpu_temp_max"), ("gpu_temp_c", 1, "gpu_temp_max")]
    title("Hourly history (last %d h)" % hours, human)
    rows = [["hour"] + [c[2] for c in cols]]
    for h in sorted(data):
        label = time.strftime("%a %d.%m. %H:00", time.localtime(h * 3600)) if human else str(h * 3600)
        rows.append([label] + [fmt(METRICS[n][1], data[h][n][i] if n in data[h] else None, human) for n, i, _ in cols])
    table(rows, human)

def report(args):
    human = args.human_readable
    if not os.path.exists(DB_PATH):
        sys.exit("no data yet - is the daemon running? try: systemctl --user status sysstat")
    db = sqlite3.connect("file:" + DB_PATH + "?mode=ro", uri=True)
    d = collect(db)
    if args.json:
        print(json.dumps(d, indent=2))
        return
    if args.history:
        history(db, args.history, human)
        return
    meta, boots, stats, procs = d["meta"], d["boots"], d["stats"], d["procs"]
    now = time.time()
    first = meta.get("first_start", now)
    tracked = meta.get("tracked_total", 0)
    cov = 100.0 * tracked / max(now - first, 1)
    up = float(read("/proc/uptime").split()[0])
    cur = read("/proc/sys/kernel/random/boot_id").strip()
    this_boot = next((b["tracked"] for b in boots if b["boot_id"] == cur), 0)
    age = now - max([s["last_ts"] for s in stats.values()] or [now])
    ram_total = 0
    for line in read("/proc/meminfo").splitlines():
        if line.startswith("MemTotal"):
            ram_total = int(line.split()[1]) / 1024
    samples = max([s["samples"] for s in stats.values()] or [0])
    info = [
        ("first_start", "%.0f" % first, "%s  (%s ago)" % (ts_fmt(first), dur(now - first))),
        ("tracked_seconds", "%.0f" % tracked, dur(tracked) + "  (awake time with daemon running)"),
        ("coverage_percent", "%.2f" % cov, "%.1f%% of wall time since start (rest: off or suspended)" % cov),
        ("boots_seen", str(len(boots)), str(len(boots))),
        ("daemon_starts", "%.0f" % meta.get("daemon_starts", 0), "%.0f" % meta.get("daemon_starts", 0)),
        ("system_uptime_seconds", "%.0f" % up, dur(up)),
        ("this_boot_tracked_seconds", "%.0f" % this_boot, dur(this_boot)),
        ("samples", str(samples), str(samples)),
        ("last_sample_age_seconds", "%.0f" % age, dur(age) + " ago" + ("  (daemon not running?)" if age > 180 else "")),
        ("cpu_model", cpu_model(), cpu_model()),
        ("cpu_threads", str(os.cpu_count()), str(os.cpu_count())),
        ("ram_total_mb", "%.0f" % ram_total, hv("MB", ram_total)),
        ("kernel", os.uname().release, os.uname().release),
    ]
    title("Overview", human)
    table([[k, h if human else r] for k, r, h in info], human, left=True)
    for g in GROUPS:
        names = [n for n, m in METRICS.items() if m[2] == g and n in stats]
        if not names:
            continue
        title(g, human)
        rows = [["metric"] + [c if c != "last" else "now" for c in COLS]]
        for n in names:
            label, unit, _ = METRICS[n]
            rows.append([label if human else n] + [fmt(unit, stats[n][c], human) for c in COLS])
        table(rows, human)
    tot = sum(p["cpu_s"] for p in procs) or 1
    title("Top processes by total CPU time", human)
    rows = [["process", "cpu_time", "share", "avg_ram", "max_ram"]]
    for p in sorted(procs, key=lambda p: -p["cpu_s"])[:args.top]:
        rows.append([p["name"], dur(p["cpu_s"]) if human else "%.1f" % p["cpu_s"], "%.1f%%" % (100 * p["cpu_s"] / tot),
                     fmt("MB", p["avg_rss"] / 1048576, human), fmt("MB", p["max_rss"] / 1048576, human)])
    table(rows, human)
    title("Top processes by peak RAM (all instances of a name summed)", human)
    rows = [["process", "max_ram", "avg_ram", "cpu_time"]]
    for p in sorted(procs, key=lambda p: -p["max_rss"])[:args.top]:
        rows.append([p["name"], fmt("MB", p["max_rss"] / 1048576, human), fmt("MB", p["avg_rss"] / 1048576, human),
                     dur(p["cpu_s"]) if human else "%.1f" % p["cpu_s"]])
    table(rows, human)

def main():
    ap = argparse.ArgumentParser(prog="sysstat", add_help=False,
                                 description="Long-term CPU/GPU/RAM/disk/network statistics collected by the sysstat daemon.")
    ap.add_argument("-h", "--human-readable", action="store_true", help="formatted output with units and durations")
    ap.add_argument("--help", action="help", help="show this help")
    ap.add_argument("-j", "--json", action="store_true", help="dump everything as JSON")
    ap.add_argument("--history", nargs="?", const=24, type=int, metavar="HOURS", help="hourly avg/max table (default: 24 h)")
    ap.add_argument("--top", type=int, default=10, help="rows in the process tables")
    ap.add_argument("--daemon", action="store_true", help="run the collector (used by systemd)")
    args = ap.parse_args()
    daemon() if args.daemon else report(args)

if __name__ == "__main__":
    main()

